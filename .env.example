# Cấu hình môi trường chung cho toàn bộ hệ thống
# Lưu ý: Không commit file .env chứa mật khẩu thật lên Git

# Cổng truy cập bên ngoài qua Gateway (Nginx)
GATEWAY_PORT=80

# Cổng nội bộ của các microservice
AUTH_SERVICE_PORT=8001
CATALOG_SERVICE_PORT=8002
BOOKING_SERVICE_PORT=8003
NOTIFICATION_SERVICE_PORT=8004

# PostgreSQL Database (1 Postgres instance, 4 database độc lập theo mô hình database-per-service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_dev
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

AUTH_DB_NAME=auth_db
CATALOG_DB_NAME=catalog_db
BOOKING_DB_NAME=booking_db
NOTIFICATION_DB_NAME=notification_db

AUTH_DATABASE_URL=postgresql://postgres:postgres_password_dev@postgres:5432/auth_db
CATALOG_DATABASE_URL=postgresql://postgres:postgres_password_dev@postgres:5432/catalog_db
BOOKING_DATABASE_URL=postgresql://postgres:postgres_password_dev@postgres:5432/booking_db
NOTIFICATION_DATABASE_URL=postgresql://postgres:postgres_password_dev@postgres:5432/notification_db

# Redis (Dùng làm cache cho Catalog và Queue/Streams cho Booking -> Notification)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# JWT Auth Configuration (Dùng chung secret key để các service tự decode xác thực)
JWT_SECRET_KEY=dev_super_secret_jwt_key_medical_booking_system_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Prometheus & Grafana
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
