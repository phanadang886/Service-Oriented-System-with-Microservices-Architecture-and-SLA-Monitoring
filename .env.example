# =============================================================================
# .env.example — EXAMPLE CONFIG (does NOT contain real secrets)
# -----------------------------------------------------------------------------
# How to use:
#   copy .env.example .env
#   then open .env and replace every "<change your secret>" with your own value.
#
#   - The real .env file is never committed (blocked in .gitignore).
#   - This .env.example file IS committed, as shared docs for the team.
# =============================================================================

# ---- Environment ----
APP_ENV=development
LOG_LEVEL=INFO

# ---- API Gateway port (Nginx) ----
GATEWAY_PORT=8080

# ---- CORS: allowed origins for the React + Vite frontend (comma-separated) ----
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Database ----
POSTGRES_USER=app
POSTGRES_PASSWORD=<change your secret>
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- Each service has its own database ----
AUTH_DB_NAME=auth_db
CATALOG_DB_NAME=catalog_db
BOOKING_DB_NAME=booking_db
NOTIFICATION_DB_NAME=notification_db

# ---- Full connection strings ----
# Write the full URL so the code does not have to build the string.
# NOTE: ${POSTGRES_PASSWORD} is expanded from the value above (works with both
# Docker Compose and python-dotenv), so it stays in sync automatically.
AUTH_DB_URL=postgresql+asyncpg://app:${POSTGRES_PASSWORD}@postgres:5432/auth_db
CATALOG_DB_URL=postgresql+asyncpg://app:${POSTGRES_PASSWORD}@postgres:5432/catalog_db
BOOKING_DB_URL=postgresql+asyncpg://app:${POSTGRES_PASSWORD}@postgres:5432/booking_db
NOTIFICATION_DB_URL=postgresql+asyncpg://app:${POSTGRES_PASSWORD}@postgres:5432/notification_db

# Connection pool (see docs/api-spec.md — record the chosen value and the values tried)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ---- Redis ----
# Used for two things: Catalog caching + Redis Streams (Booking -> Notification)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
# Leave empty for local dev; set a password if Redis is exposed.
REDIS_PASSWORD=
# Catalog cache: time to live
CATALOG_CACHE_TTL_SECONDS=300
# Name of the appointment event stream
BOOKING_EVENTS_STREAM=appointment_events

# ---- Security ----
# Generate a new key with:  openssl rand -hex 32
JWT_SECRET=<change your secret>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ---- Ports (only used when running outside Docker) ----
AUTH_PORT=8001
CATALOG_PORT=8002
BOOKING_PORT=8003
NOTIFICATION_PORT=8004

# ---- Monitoring ----
PROMETHEUS_RETENTION=15d
GRAFANA_ADMIN_PASSWORD=<change your secret>
